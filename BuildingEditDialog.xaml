<Window x:Class="Klucznik.BuildingEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Budynek"
        Height="220"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppPageBrush}"
        Style="{StaticResource MaterialDesignWindow}">

    <Border Margin="20"
            Padding="24"
            Background="{StaticResource AppSurfaceBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBox x:Name="NameTextBox"
                     Grid.Row="0"
                     Height="46"
                     Margin="0,0,0,16"
                     materialDesign:HintAssist.Hint="Nazwa budynku"/>

            <TextBlock Grid.Row="1"
                       Text="Nazwa musi być unikalna."
                       Style="{StaticResource AppMutedTextStyle}"/>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Anuluj"
                        Width="110"
                        Height="38"
                        Margin="0,0,8,0"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Click="Cancel_Click"/>
                <Button Content="Zapisz"
                        Width="110"
                        Height="38"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>