<Window x:Class="MojaAplikacja.RfidAssignDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Przypisz RFID"
        Height="190"
        Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Zeskanuj RFID"
                   FontSize="20"
                   FontWeight="SemiBold"
                   Margin="0,0,0,12"/>

        <TextBlock Grid.Row="1"
                   Text="Oczekiwanie na skan..."
                   FontSize="16"
                   VerticalAlignment="Center" />

        <TextBox x:Name="HiddenRfidTextBox"
                 Grid.Row="1"
                 Width="1"
                 Height="1"
                 Opacity="0"
                 KeyDown="HiddenRfidTextBox_KeyDown" />

        <TextBlock Grid.Row="2"
                   Margin="0,12,0,12"
                   Text="Po zeskanowaniu zapis nastąpi automatycznie."
                   TextWrapping="Wrap" />

        <Button Grid.Row="2"
                Content="Anuluj"
                Width="100"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Click="Cancel_Click"/>
    </Grid>
</Window>