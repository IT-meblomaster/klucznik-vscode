<Window x:Class="Klucznik.RfidAssignDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Przypisz RFID"
        Height="260"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppPageBrush}"
        Style="{StaticResource MaterialDesignWindow}">

    <Border Margin="20"
            Padding="24"
            Background="{StaticResource AppSurfaceBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Zeskanuj RFID"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>

            <TextBlock Grid.Row="1"
                       Text="Oczekiwanie na skan..."
                       FontSize="16"
                       Foreground="{StaticResource AppMutedBrush}"
                       VerticalAlignment="Center"/>

            <TextBox x:Name="HiddenRfidTextBox"
                     Grid.Row="1"
                     Width="1"
                     Height="1"
                     Opacity="0"
                     KeyDown="HiddenRfidTextBox_KeyDown"/>

            <TextBlock Grid.Row="2"
                       Text="Po zeskanowaniu zapis nastąpi automatycznie."
                       Foreground="{StaticResource AppMutedBrush}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,16"/>

            <Button Grid.Row="3"
                    Content="Anuluj"
                    Width="110"
                    Height="38"
                    HorizontalAlignment="Right"
                    Style="{StaticResource MaterialDesignOutlinedButton}"
                    Click="Cancel_Click"/>
        </Grid>
    </Border>
</Window>

