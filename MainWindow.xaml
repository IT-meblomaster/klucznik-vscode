<Window x:Class="MojaAplikacja.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System"
        Height="760"
        Width="1240"
        MinHeight="760"
        MinWidth="1240"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        PreviewTextInput="Window_PreviewTextInput"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="5">
            <TextBlock Text="System RFID"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="5"/>

            <Button x:Name="LockButton"
                    Content="Odblokuj ustawienia"
                    DockPanel.Dock="Right"
                    Width="150"
                    Height="26"
                    HorizontalAlignment="Right"
                    Margin="5"
                    Click="LockButton_Click"/>
        </DockPanel>

        <TabControl x:Name="MainTabs" Grid.Row="1">

            <TabItem Header="Skaner">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="0,0,0,18"
                          MinHeight="240">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <GroupBox Header="Pracownik" Grid.Column="0">
                            <Grid Margin="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Imię" FontWeight="Bold"/>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding FirstName}"
                                           FontSize="24"
                                           Margin="0,4,0,14"/>

                                <TextBlock Grid.Row="2"
                                           Text="Nazwisko"
                                           FontWeight="Bold"/>
                                <TextBlock Grid.Row="3"
                                           Text="{Binding LastName}"
                                           FontSize="24"
                                           Margin="0,4,0,14"/>

                                <TextBlock Grid.Row="3"
                                           Text="{Binding EmployeeCardDisplay}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom"
                                           FontSize="14"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Klucz" Grid.Column="2">
                            <Grid Margin="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Numer klucza"
                                           FontWeight="Bold"/>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding CurrentKeyName}"
                                           FontSize="24"
                                           Margin="0,4,0,10"/>

                                <TextBlock Grid.Row="2"
                                           Text="Budynek"
                                           FontWeight="Bold"/>
                                <TextBlock Grid.Row="3"
                                           Text="{Binding CurrentKeyBuilding}"
                                           FontSize="22"
                                           Margin="0,4,0,10"/>

                                <TextBlock Grid.Row="4"
                                           Text="Opis"
                                           FontWeight="Bold"/>
                                <TextBlock Grid.Row="5"
                                           Text="{Binding CurrentKeyDescription}"
                                           FontSize="20"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,14"/>

                                <TextBlock Grid.Row="6"
                                           Text="{Binding CurrentKeyRfidStatus}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom"
                                           FontSize="14"/>
                            </Grid>
                        </GroupBox>
                    </Grid>

                    <GroupBox Grid.Row="1"
                              Header="Log operacji"
                              MinHeight="200">
                        <DataGrid ItemsSource="{Binding ScannerLogs}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Data i godzina"
                                                    Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                    Width="200" />
                                <DataGridTextColumn Header="Opis"
                                                    Binding="{Binding Message}"
                                                    Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>
                </Grid>
            </TabItem>

            <TabItem x:Name="KeysTab"
                     Header="Klucze"
                     PreviewMouseLeftButtonDown="ProtectedTab_PreviewMouseLeftButtonDown">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,12">
                        <GroupBox Header="Klucze" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" Margin="8,6,8,8">
                                <Button Content="Nowy"
                                        Width="100"
                                        Margin="0,0,8,0"
                                        Click="NewKey_Click"/>
                                <Button Content="Edytuj"
                                        Width="100"
                                        Margin="0,0,8,0"
                                        Click="EditKey_Click"
                                        IsEnabled="{Binding CanEditOrDeleteKey}"/>
                                <Button Content="Usuń"
                                        Width="100"
                                        Click="DeleteKey_Click"
                                        IsEnabled="{Binding CanEditOrDeleteKey}"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="RFID">
                            <StackPanel Orientation="Horizontal" Margin="8,6,8,8">
                                <Button Content="Przypisz RFID"
                                        Width="130"
                                        Margin="0,0,8,0"
                                        Click="AssignRfid_Click"
                                        IsEnabled="{Binding CanAssignRfid}"/>
                                <Button Content="Usuń RFID"
                                        Width="110"
                                        Click="RemoveRfid_Click"
                                        IsEnabled="{Binding CanRemoveRfid}"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding Keys}"
                              SelectedItem="{Binding SelectedKey, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              MouseDoubleClick="KeysGrid_MouseDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nazwa"
                                                Binding="{Binding Name}"
                                                Width="180" />
                            <DataGridTextColumn Header="Budynek"
                                                Binding="{Binding Building}"
                                                Width="120" />
                            <DataGridTextColumn Header="Zawieszka"
                                                Binding="{Binding Hanger}"
                                                Width="120" />
                            <DataGridTextColumn Header="Opis"
                                                Binding="{Binding Description}"
                                                Width="*" />
                            <DataGridTextColumn Header="Status RFID"
                                                Binding="{Binding RfidStatus}"
                                                Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Logi">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <GroupBox Header="Filtry" Grid.Row="0" Margin="0,0,0,10">
                        <Grid Margin="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="55"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="55"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="75"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="40"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Od:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,6"/>
                            <DatePicker Grid.Column="1"
                                        Height="26"
                                        Margin="0,0,8,6"
                                        SelectedDate="{Binding ReportDateFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Column="2"
                                       Text="Do:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,6"/>
                            <DatePicker Grid.Column="3"
                                        Height="26"
                                        Margin="0,0,8,6"
                                        SelectedDate="{Binding ReportDateTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Column="4"
                                       Text="Pracownik:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,6"/>
                            <ComboBox Grid.Column="5"
                                      Height="26"
                                      Margin="0,0,8,6"
                                      ItemsSource="{Binding ReportUsers}"
                                      SelectedItem="{Binding SelectedReportUser, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Column="6"
                                       Text="Klucz:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,6"/>
                            <ComboBox Grid.Column="7"
                                      Height="26"
                                      Margin="0,0,8,6"
                                      ItemsSource="{Binding ReportKeys}"
                                      SelectedItem="{Binding SelectedReportKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock Grid.Column="8"
                                       Text="Budynek:"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,6"/>
                            <ComboBox Grid.Column="9"
                                      Height="26"
                                      Margin="0,0,8,6"
                                      ItemsSource="{Binding ReportBuildings}"
                                      SelectedItem="{Binding SelectedReportBuilding, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <Button Grid.Column="10"
                                    Content="Wyczyść filtry"
                                    Width="120"
                                    Height="26"
                                    Margin="0,0,0,6"
                                    Click="ClearReportFilters_Click"/>
                        </Grid>
                    </GroupBox>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding LoanReports}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False"
                              HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Data i godzina"
                                                Binding="{Binding EventTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                Width="190"/>
                            <DataGridTextColumn Header="Typ"
                                                Binding="{Binding EventType}"
                                                Width="110"/>
                            <DataGridTextColumn Header="Klucz"
                                                Binding="{Binding KeyName}"
                                                Width="220"/>
                            <DataGridTextColumn Header="Budynek"
                                                Binding="{Binding Building}"
                                                Width="120"/>
                            <DataGridTextColumn Header="Użytkownik"
                                                Binding="{Binding UserName}"
                                                Width="300"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Inwentaryzacja">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding InventoryGroups}" Margin="16">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <GroupBox Header="{Binding BuildingName}" Margin="0,0,0,18">
                                    <ItemsControl ItemsSource="{Binding Keys}" Margin="10">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>

                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="170"
                                                        Height="130"
                                                        Margin="8"
                                                        Padding="10"
                                                        CornerRadius="10"
                                                        BorderBrush="#80909090"
                                                        BorderThickness="1"
                                                        ToolTip="{Binding InventoryTooltip}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="#D9F2E6"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsIssued}" Value="True">
                                                                    <Setter Property="Background" Value="#F4D6D6"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Grid.Row="0"
                                                                   Text="{Binding Name}"
                                                                   FontSize="16"
                                                                   FontWeight="SemiBold"
                                                                   TextAlignment="Center"
                                                                   TextWrapping="Wrap"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,2"/>

                                                        <TextBlock Grid.Row="1"
                                                                   Text="{Binding InventoryDescriptionLine}"
                                                                   FontSize="14"
                                                                   FontWeight="Normal"
                                                                   TextAlignment="Center"
                                                                   TextWrapping="Wrap"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,0"/>

                                                        <TextBlock Grid.Row="2"
                                                                   Text="{Binding InventoryHangerLine}"
                                                                   FontSize="14"
                                                                   FontWeight="Normal"
                                                                   TextAlignment="Center"
                                                                   TextWrapping="Wrap"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,4"/>

                                                        <Border Grid.Row="3"/>

                                                        <TextBlock Grid.Row="4"
                                                                   Text="{Binding InventoryStatusText}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,2"/>

                                                        <TextBlock Grid.Row="5"
                                                                   Text="{Binding IssuedToName}"
                                                                   FontSize="11"
                                                                   TextAlignment="Center"
                                                                   TextWrapping="Wrap"
                                                                   HorizontalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsIssued}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </GroupBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="SettingsTab"
                     Header="Ustawienia"
                     PreviewMouseLeftButtonDown="ProtectedTab_PreviewMouseLeftButtonDown">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">

                        <GroupBox Header="{Binding AdminPasswordHeader}" Margin="0,0,0,16">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Nowe hasło"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,8"/>
                                <PasswordBox x:Name="AdminNewPasswordBox"
                                             Grid.Column="1"
                                             Margin="0,0,0,8"/>

                                <TextBlock Grid.Row="1"
                                           Text="Powtórz hasło"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,8"/>
                                <PasswordBox x:Name="AdminRepeatPasswordBox"
                                             Grid.Row="1"
                                             Grid.Column="1"
                                             Margin="0,0,0,8"/>

                                <StackPanel Grid.Row="2"
                                            Grid.ColumnSpan="2"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Button Content="Zapisz hasło"
                                            Width="120"
                                            Click="SaveAdminPassword_Click"/>
                                </StackPanel>

                                <TextBlock Grid.Row="3"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding AdminPasswordStatus}"
                                           FontSize="14"
                                           Margin="0,10,0,0"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Oracle" Margin="0,0,0,16">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Adres"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,8"/>
                                <TextBox Grid.Column="1"
                                         Margin="0,0,0,8"
                                         Text="{Binding OracleSettings.Address, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding OracleSettings.IsReadOnly}"/>

                                <TextBlock Grid.Row="1"
                                           Text="Użytkownik"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,8"/>
                                <TextBox Grid.Row="1"
                                         Grid.Column="1"
                                         Margin="0,0,0,8"
                                         Text="{Binding OracleSettings.User, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding OracleSettings.IsReadOnly}"/>

                                <TextBlock Grid.Row="2"
                                           Text="Hasło"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,8"/>
                                <PasswordBox x:Name="OraclePasswordBox"
                                             Grid.Row="2"
                                             Grid.Column="1"
                                             Margin="0,0,0,8"
                                             IsEnabled="{Binding OracleSettings.IsEditing}"
                                             PasswordChanged="OraclePasswordBox_PasswordChanged"/>

                                <TextBlock Grid.Row="3"
                                           Text="Nazwa bazy"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,8"/>
                                <TextBox Grid.Row="3"
                                         Grid.Column="1"
                                         Margin="0,0,0,8"
                                         Text="{Binding OracleSettings.DatabaseName, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding OracleSettings.IsReadOnly}"/>

                                <StackPanel Grid.Row="4"
                                            Grid.ColumnSpan="2"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Button Content="Edytuj"
                                            Width="100"
                                            Click="EditOracle_Click"
                                            Visibility="{Binding OracleSettings.ShowEditButton, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Button Content="Zapisz"
                                            Width="100"
                                            Margin="0,0,8,0"
                                            Click="SaveOracle_Click"
                                            Visibility="{Binding OracleSettings.ShowSaveCancelButtons, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Button Content="Anuluj"
                                            Width="100"
                                            Click="CancelOracle_Click"
                                            Visibility="{Binding OracleSettings.ShowSaveCancelButtons, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="mySQL" Margin="0,0,0,16">
                            <Grid Margin="12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Adres"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,8"/>
                                <TextBox Grid.Column="1"
                                         Margin="0,0,0,8"
                                         Text="{Binding MySqlSettings.Address, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding MySqlSettings.IsReadOnly}"/>

                                <TextBlock Grid.Row="1"
                                           Text="Użytkownik"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,8"/>
                                <TextBox Grid.Row="1"
                                         Grid.Column="1"
                                         Margin="0,0,0,8"
                                         Text="{Binding MySqlSettings.User, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding MySqlSettings.IsReadOnly}"/>

                                <TextBlock Grid.Row="2"
                                           Text="Hasło"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,8"/>
                                <PasswordBox x:Name="MySqlPasswordBox"
                                             Grid.Row="2"
                                             Grid.Column="1"
                                             Margin="0,0,0,8"
                                             IsEnabled="{Binding MySqlSettings.IsEditing}"
                                             PasswordChanged="MySqlPasswordBox_PasswordChanged"/>

                                <TextBlock Grid.Row="3"
                                           Text="Nazwa bazy"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,8"/>
                                <TextBox Grid.Row="3"
                                         Grid.Column="1"
                                         Margin="0,0,0,8"
                                         Text="{Binding MySqlSettings.DatabaseName, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding MySqlSettings.IsReadOnly}"/>

                                <StackPanel Grid.Row="4"
                                            Grid.ColumnSpan="2"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Button Content="Edytuj"
                                            Width="100"
                                            Click="EditMySql_Click"
                                            Visibility="{Binding MySqlSettings.ShowEditButton, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Button Content="Zapisz"
                                            Width="100"
                                            Margin="0,0,8,0"
                                            Click="SaveMySql_Click"
                                            Visibility="{Binding MySqlSettings.ShowSaveCancelButtons, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Button Content="Anuluj"
                                            Width="100"
                                            Click="CancelMySql_Click"
                                            Visibility="{Binding MySqlSettings.ShowSaveCancelButtons, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <TextBlock Text="{Binding SettingsStatus}"
                                   FontSize="14"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</Window>