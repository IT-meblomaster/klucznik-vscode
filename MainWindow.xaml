<Window x:Class="Klucznik.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Meblomaster - Klucznik v1.0.1"
        Height="820"
        Width="1320"
        MinHeight="760"
        MinWidth="1240"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppPageBrush}"
        Style="{StaticResource MaterialDesignWindow}"
        PreviewTextInput="Window_PreviewTextInput"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- Kolor podświetlenia przy zwrocie klucza-->
    <!--
        <SolidColorBrush x:Key="AppReturnSurfaceBrush" Color="#DBEAFE"/>
        <SolidColorBrush x:Key="AppReturnBorderBrush" Color="#60A5FA"/>
    -->
    
        <SolidColorBrush x:Key="AppReturnSurfaceBrush" Color="#F3E8FF"/>
        <SolidColorBrush x:Key="AppReturnBorderBrush" Color="#C084FC"/>
    
    </Window.Resources>

    <Grid Background="{StaticResource AppPageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource AppHeaderBrush}" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Meblomaster Klucznik"
                               Foreground="White"
                               FontSize="28"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Ewidencja kluczy, skanowanie kart i raporty wypożyczeń"
                               Foreground="#E1ECFF"
                               FontSize="13"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Button x:Name="LockButton"
                        Grid.Column="1"
                        Content="Odblokuj ustawienia"
                        Width="190"
                        Height="40"
                        VerticalAlignment="Center"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="LockButton_Click"/>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs"
                    Grid.Row="1"
                    Margin="20"
                    Background="Transparent">

            <TabItem Header="Skaner" MinWidth="120" Height="46">
                <Grid Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" MinHeight="230">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource AppCardStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IssuedScanFeedbackVisible}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AppSuccessSurfaceBrush}"/>
                                            <Setter Property="BorderBrush" Value="#86EFAC"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding ReturnedScanFeedbackVisible}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AppReturnSurfaceBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource AppReturnBorderBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Pracownik" Style="{StaticResource AppSectionTitleStyle}"/>

                                <TextBlock Grid.Row="1" Text="IMIĘ" Style="{StaticResource AppLabelStyle}"/>
                                <TextBlock Grid.Row="2"
                                           Text="{Binding FirstName}"
                                           Style="{StaticResource AppValueStyle}"
                                           Margin="0,0,0,16"/>

                                <TextBlock Grid.Row="3" Text="NAZWISKO" Style="{StaticResource AppLabelStyle}"/>
                                <TextBlock Grid.Row="4"
                                           Text="{Binding LastName}"
                                           Style="{StaticResource AppValueStyle}"
                                           Margin="0,0,0,16"/>

                                <TextBlock Grid.Row="5"
                                           Text="{Binding EmployeeCardDisplay}"
                                           Style="{StaticResource AppMutedTextStyle}"
                                           FontWeight="SemiBold"/>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" MinHeight="230">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource AppCardStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IssuedScanFeedbackVisible}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AppSuccessSurfaceBrush}"/>
                                            <Setter Property="BorderBrush" Value="#86EFAC"/>
                                        </DataTrigger>

                                        <DataTrigger Binding="{Binding ReturnedScanFeedbackVisible}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource AppReturnSurfaceBrush}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource AppReturnBorderBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Klucz" Style="{StaticResource AppSectionTitleStyle}"/>

                                <TextBlock Grid.Row="1" Text="NUMER KLUCZA" Style="{StaticResource AppLabelStyle}"/>
                                <TextBlock Grid.Row="2"
                                           Text="{Binding CurrentKeyName}"
                                           Style="{StaticResource AppValueStyle}"
                                           Margin="0,0,0,12"/>

                                <TextBlock Grid.Row="3" Text="BUDYNEK" Style="{StaticResource AppLabelStyle}"/>
                                <TextBlock Grid.Row="4"
                                           Text="{Binding CurrentKeyBuilding}"
                                           FontSize="22"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12"/>

                                <TextBlock Grid.Row="5" Text="OPIS" Style="{StaticResource AppLabelStyle}"/>
                                <TextBlock Grid.Row="6"
                                           Text="{Binding CurrentKeyDescription}"
                                           FontSize="16"
                                           Foreground="{StaticResource AppMutedBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,0,0,12"/>

                                <TextBlock Grid.Row="7"
                                           Text="{Binding CurrentKeyRfidStatus}"
                                           Style="{StaticResource AppMutedTextStyle}"
                                           FontWeight="SemiBold"/>
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource AppCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Log operacji" Style="{StaticResource AppSectionTitleStyle}"/>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding ScannerLogs}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Data i godzina"
                                                        Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                        Width="200"/>
                                    <DataGridTextColumn Header="Opis"
                                                        Binding="{Binding Message}"
                                                        Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Inwentaryzacja" MinWidth="160" Height="46">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
                    <ItemsControl ItemsSource="{Binding InventoryGroups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource AppCardStyle}" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="{Binding BuildingName}" Style="{StaticResource AppSectionTitleStyle}"/>

                                        <ItemsControl ItemsSource="{Binding Keys}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="225"
                                                            Height="175"
                                                            Margin="0,0,14,14"
                                                            Padding="14"
                                                            CornerRadius="12"
                                                            BorderThickness="1"
                                                            ToolTip="{Binding InventoryTooltip}">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource AppSuccessSurfaceBrush}"/>
                                                                <Setter Property="BorderBrush" Value="#86EFAC"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsIssued}" Value="True">
                                                                        <Setter Property="Background" Value="{StaticResource AppDangerSurfaceBrush}"/>
                                                                        <Setter Property="BorderBrush" Value="#FCA5A5"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>

                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>

                                                            <TextBlock Grid.Row="0"
                                                                       Text="{Binding Name}"
                                                                       FontSize="18"
                                                                       FontWeight="SemiBold"
                                                                       TextAlignment="Center"
                                                                       TextWrapping="Wrap"
                                                                       HorizontalAlignment="Center"
                                                                       Margin="0,0,0,8"/>

                                                            <TextBlock Grid.Row="1"
                                                                       Text="{Binding InventoryDescriptionLine}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{StaticResource AppMutedBrush}"
                                                                       TextAlignment="Center"
                                                                       TextWrapping="Wrap"
                                                                       HorizontalAlignment="Center"
                                                                       Margin="0,0,0,4"/>

                                                            <TextBlock Grid.Row="2"
                                                                       Text="{Binding InventoryHangerLine}"
                                                                       FontSize="13"
                                                                       Foreground="{StaticResource AppMutedBrush}"
                                                                       TextAlignment="Center"
                                                                       TextWrapping="Wrap"
                                                                       HorizontalAlignment="Center"
                                                                       Margin="0,0,0,8"/>

                                                            <TextBlock Grid.Row="3"
                                                                       Text="{Binding IssuedToName}"
                                                                       FontSize="12"
                                                                       Foreground="{StaticResource AppDangerBrush}"
                                                                       TextAlignment="Center"
                                                                       TextWrapping="Wrap"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsIssued}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <Border Grid.Row="4"
                                                                    Height="1"
                                                                    Background="#D1D5DB"
                                                                    Margin="0,0,0,8"/>

                                                            <TextBlock Grid.Row="5"
                                                                       Text="{Binding InventoryStatusText}"
                                                                       FontSize="13"
                                                                       FontWeight="SemiBold"
                                                                       HorizontalAlignment="Center">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource AppSuccessBrush}"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsIssued}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource AppDangerBrush}"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Logi" MinWidth="120" Height="46">
                <Grid Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource AppCardStyle}" Margin="0,0,0,18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Filtry" Style="{StaticResource AppSectionTitleStyle}"/>

                            <WrapPanel Grid.Row="1">
                                <DatePicker Width="190"
                                            Height="42"
                                            Margin="0,0,12,12"
                                            materialDesign:HintAssist.Hint="Od"
                                            SelectedDate="{Binding ReportDateFrom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <DatePicker Width="190"
                                            Height="42"
                                            Margin="0,0,12,12"
                                            materialDesign:HintAssist.Hint="Do"
                                            SelectedDate="{Binding ReportDateTo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <ComboBox Width="220"
                                          Height="42"
                                          Margin="0,0,12,12"
                                          materialDesign:HintAssist.Hint="Pracownik"
                                          ItemsSource="{Binding ReportUsers}"
                                          SelectedItem="{Binding SelectedReportUser, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <ComboBox Width="220"
                                          Height="42"
                                          Margin="0,0,12,12"
                                          materialDesign:HintAssist.Hint="Klucz"
                                          ItemsSource="{Binding ReportKeys}"
                                          SelectedItem="{Binding SelectedReportKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <ComboBox Width="220"
                                          Height="42"
                                          Margin="0,0,12,12"
                                          materialDesign:HintAssist.Hint="Budynek"
                                          ItemsSource="{Binding ReportBuildings}"
                                          SelectedItem="{Binding SelectedReportBuilding, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                                <Button Content="Wyczyść filtry"
                                        Width="150"
                                        Height="38"
                                        Margin="0,2,0,12"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Click="ClearReportFilters_Click"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource AppCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Raport wypożyczeń" Style="{StaticResource AppSectionTitleStyle}"/>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding LoanReports}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      CanUserAddRows="False"
                                      HeadersVisibility="Column">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Data i godzina"
                                                        Binding="{Binding EventTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                        Width="190"/>
                                    <DataGridTextColumn Header="Typ"
                                                        Binding="{Binding EventType}"
                                                        Width="120"/>
                                    <DataGridTextColumn Header="Klucz"
                                                        Binding="{Binding KeyName}"
                                                        Width="220"/>
                                    <DataGridTextColumn Header="Budynek"
                                                        Binding="{Binding Building}"
                                                        Width="140"/>
                                    <DataGridTextColumn Header="Użytkownik"
                                                        Binding="{Binding UserName}"
                                                        Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem x:Name="KeysTab"
                     Header="Klucze"
                     MinWidth="120"
                     Height="46"
                     PreviewMouseLeftButtonDown="ProtectedTab_PreviewMouseLeftButtonDown">
                <Grid Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource AppCardStyle}" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Zarządzanie kluczami"
                                           FontSize="20"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Dodawanie, edycja oraz przypisywanie identyfikatorów RFID"
                                           Style="{StaticResource AppMutedTextStyle}"
                                           Margin="0,4,0,0"/>
                            </StackPanel>

                            <WrapPanel Grid.Column="1"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center">
                                <Button Content="Nowy"
                                        Width="100"
                                        Height="38"
                                        Margin="0,0,8,8"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Click="NewKey_Click"/>
                                <Button Content="Edytuj"
                                        Width="100"
                                        Height="38"
                                        Margin="0,0,8,8"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Click="EditKey_Click"
                                        IsEnabled="{Binding CanEditOrDeleteKey}"/>
                                <Button Content="Usuń"
                                        Width="100"
                                        Height="38"
                                        Margin="0,0,16,8"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Click="DeleteKey_Click"
                                        IsEnabled="{Binding CanEditOrDeleteKey}"/>
                                <Button Content="Przypisz RFID"
                                        Width="140"
                                        Height="38"
                                        Margin="0,0,8,8"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Click="AssignRfid_Click"
                                        IsEnabled="{Binding CanAssignRfid}"/>
                                <Button Content="Usuń RFID"
                                        Width="120"
                                        Height="38"
                                        Margin="0,0,0,8"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Click="RemoveRfid_Click"
                                        IsEnabled="{Binding CanRemoveRfid}"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource AppCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Lista kluczy" Style="{StaticResource AppSectionTitleStyle}"/>

                            <DataGrid Grid.Row="1"
                                    ItemsSource="{Binding Keys}"
                                    SelectedItem="{Binding SelectedKey, Mode=TwoWay}"
                                    AutoGenerateColumns="False"
                                    IsReadOnly="True"
                                    CanUserAddRows="False"
                                    CanUserDeleteRows="False"
                                    SelectionMode="Single"
                                    SelectionUnit="FullRow"
                                    EnableRowVirtualization="False"
                                    EnableColumnVirtualization="False"
                                    VirtualizingPanel.IsVirtualizing="False"
                                    ScrollViewer.CanContentScroll="False"
                                    MouseDoubleClick="KeysGrid_MouseDoubleClick">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Nazwa"
                                                        Binding="{Binding Name}"
                                                        Width="180"/>
                                    <DataGridTextColumn Header="Budynek"
                                                        Binding="{Binding Building}"
                                                        Width="140"/>
                                    <DataGridTextColumn Header="Zawieszka"
                                                        Binding="{Binding Hanger}"
                                                        Width="130"/>
                                    <DataGridTextColumn Header="Opis"
                                                        Binding="{Binding Description}"
                                                        Width="*"/>
                                    <DataGridTextColumn Header="Status RFID"
                                                        Binding="{Binding RfidStatus}"
                                                        Width="150"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Budynki"
                    MinWidth="120"
                    Height="46"
                    PreviewMouseLeftButtonDown="ProtectedTab_PreviewMouseLeftButtonDown">
                <Grid Margin="0,18,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource AppCardStyle}" Margin="0,0,0,18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Zarządzanie budynkami"
                                        FontSize="20"
                                        FontWeight="SemiBold"/>
                                <TextBlock Text="Dodawanie, edycja oraz usuwanie budynków"
                                        Style="{StaticResource AppMutedTextStyle}"
                                        Margin="0,4,0,0"/>
                            </StackPanel>

                            <WrapPanel Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                                <Button Content="Nowy"
                                        Width="100"
                                        Height="38"
                                        Margin="0,0,8,8"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Click="NewBuilding_Click"/>
                                <Button Content="Edytuj"
                                        Width="100"
                                        Height="38"
                                        Margin="0,0,8,8"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Click="EditBuilding_Click"
                                        IsEnabled="{Binding CanEditOrDeleteBuilding}"/>
                                <Button Content="Usuń"
                                        Width="100"
                                        Height="38"
                                        Margin="0,0,0,8"
                                        Style="{StaticResource MaterialDesignOutlinedButton}"
                                        Click="DeleteBuilding_Click"
                                        IsEnabled="{Binding CanEditOrDeleteBuilding}"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource AppCardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="Lista budynków" Style="{StaticResource AppSectionTitleStyle}"/>

                            <DataGrid Grid.Row="1"
                                    ItemsSource="{Binding Buildings}"
                                    SelectedItem="{Binding SelectedBuilding, Mode=TwoWay}"
                                    AutoGenerateColumns="False"
                                    IsReadOnly="True"
                                    SelectionMode="Single"
                                    SelectionUnit="FullRow"
                                    MouseDoubleClick="BuildingsGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID"
                                                        Binding="{Binding Id}"
                                                        Width="100"/>
                                    <DataGridTextColumn Header="Nazwa"
                                                        Binding="{Binding Name}"
                                                        Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>













            <TabItem x:Name="SettingsTab"
                     Header="Ustawienia"
                     MinWidth="140"
                     Height="46"
                     PreviewMouseLeftButtonDown="ProtectedTab_PreviewMouseLeftButtonDown">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,18,0,0">
                    <StackPanel>

                        <Border Style="{StaticResource AppCardStyle}" Margin="0,0,0,18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.ColumnSpan="2"
                                           Text="{Binding AdminPasswordHeader}"
                                           Style="{StaticResource AppSectionTitleStyle}"/>

                                <PasswordBox x:Name="AdminNewPasswordBox"
                                             Grid.Row="1"
                                             Grid.Column="0"
                                             Height="46"
                                             Margin="0,0,12,12"
                                             materialDesign:HintAssist.Hint="Nowe hasło"/>

                                <PasswordBox x:Name="AdminRepeatPasswordBox"
                                             Grid.Row="1"
                                             Grid.Column="1"
                                             Height="46"
                                             Margin="12,0,0,12"
                                             materialDesign:HintAssist.Hint="Powtórz hasło"/>

                                <Button Grid.Row="2"
                                        Grid.ColumnSpan="2"
                                        Content="Zapisz hasło"
                                        Width="150"
                                        Height="38"
                                        HorizontalAlignment="Right"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Click="SaveAdminPassword_Click"/>

                                <TextBlock Grid.Row="3"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding AdminPasswordStatus}"
                                           Style="{StaticResource AppMutedTextStyle}"
                                           Margin="0,12,0,0"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource AppCardStyle}" Margin="0,0,0,18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.ColumnSpan="2" Text="Oracle" Style="{StaticResource AppSectionTitleStyle}"/>

                                <TextBox Grid.Row="1"
                                         Grid.Column="0"
                                         Height="46"
                                         Margin="0,0,12,12"
                                         materialDesign:HintAssist.Hint="Adres"
                                         Text="{Binding OracleSettings.Address, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding OracleSettings.IsReadOnly}"/>

                                <TextBox Grid.Row="1"
                                         Grid.Column="1"
                                         Height="46"
                                         Margin="12,0,0,12"
                                         materialDesign:HintAssist.Hint="Użytkownik"
                                         Text="{Binding OracleSettings.User, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding OracleSettings.IsReadOnly}"/>

                                <PasswordBox x:Name="OraclePasswordBox"
                                             Grid.Row="2"
                                             Grid.Column="0"
                                             Height="46"
                                             Margin="0,0,12,12"
                                             materialDesign:HintAssist.Hint="Hasło"
                                             IsEnabled="{Binding OracleSettings.IsEditing}"
                                             PasswordChanged="OraclePasswordBox_PasswordChanged"/>

                                <TextBox Grid.Row="2"
                                         Grid.Column="1"
                                         Height="46"
                                         Margin="12,0,0,12"
                                         materialDesign:HintAssist.Hint="Nazwa bazy"
                                         Text="{Binding OracleSettings.DatabaseName, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding OracleSettings.IsReadOnly}"/>

                                <StackPanel Grid.Row="5"
                                            Grid.ColumnSpan="2"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Button Content="Edytuj"
                                            Width="100"
                                            Height="38"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Click="EditOracle_Click"
                                            Visibility="{Binding OracleSettings.ShowEditButton, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Button Content="Zapisz"
                                            Width="100"
                                            Height="38"
                                            Margin="0,0,8,0"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Click="SaveOracle_Click"
                                            Visibility="{Binding OracleSettings.ShowSaveCancelButtons, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Button Content="Anuluj"
                                            Width="100"
                                            Height="38"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Click="CancelOracle_Click"
                                            Visibility="{Binding OracleSettings.ShowSaveCancelButtons, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource AppCardStyle}" Margin="0,0,0,18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.ColumnSpan="2" Text="mySQL" Style="{StaticResource AppSectionTitleStyle}"/>

                                <TextBox Grid.Row="1"
                                         Grid.Column="0"
                                         Height="46"
                                         Margin="0,0,12,12"
                                         materialDesign:HintAssist.Hint="Adres"
                                         Text="{Binding MySqlSettings.Address, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding MySqlSettings.IsReadOnly}"/>

                                <TextBox Grid.Row="1"
                                         Grid.Column="1"
                                         Height="46"
                                         Margin="12,0,0,12"
                                         materialDesign:HintAssist.Hint="Użytkownik"
                                         Text="{Binding MySqlSettings.User, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding MySqlSettings.IsReadOnly}"/>

                                <PasswordBox x:Name="MySqlPasswordBox"
                                             Grid.Row="2"
                                             Grid.Column="0"
                                             Height="46"
                                             Margin="0,0,12,12"
                                             materialDesign:HintAssist.Hint="Hasło"
                                             IsEnabled="{Binding MySqlSettings.IsEditing}"
                                             PasswordChanged="MySqlPasswordBox_PasswordChanged"/>

                                <TextBox Grid.Row="2"
                                         Grid.Column="1"
                                         Height="46"
                                         Margin="12,0,0,12"
                                         materialDesign:HintAssist.Hint="Nazwa bazy"
                                         Text="{Binding MySqlSettings.DatabaseName, UpdateSourceTrigger=PropertyChanged}"
                                         IsReadOnly="{Binding MySqlSettings.IsReadOnly}"/>

                                <StackPanel Grid.Row="5"
                                            Grid.ColumnSpan="2"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Right">
                                    <Button Content="Edytuj"
                                            Width="100"
                                            Height="38"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Click="EditMySql_Click"
                                            Visibility="{Binding MySqlSettings.ShowEditButton, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Button Content="Zapisz"
                                            Width="100"
                                            Height="38"
                                            Margin="0,0,8,0"
                                            Style="{StaticResource MaterialDesignRaisedButton}"
                                            Click="SaveMySql_Click"
                                            Visibility="{Binding MySqlSettings.ShowSaveCancelButtons, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                    <Button Content="Anuluj"
                                            Width="100"
                                            Height="38"
                                            Style="{StaticResource MaterialDesignOutlinedButton}"
                                            Click="CancelMySql_Click"
                                            Visibility="{Binding MySqlSettings.ShowSaveCancelButtons, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                </StackPanel>
                            </Grid>
                        </Border>


                        <Border Style="{StaticResource AppCardStyle}" Margin="0,0,0,18">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.ColumnSpan="4"
                                           Text="Czytnik RFID / klawiatura"
                                           Style="{StaticResource AppSectionTitleStyle}"/>

                                <TextBox Grid.Row="1"
                                         Grid.Column="0"
                                         Height="46"
                                         Margin="0,0,12,12"
                                         materialDesign:HintAssist.Hint="VID"
                                         Text="{Binding ScannerSettings.Vid, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBox Grid.Row="1"
                                         Grid.Column="1"
                                         Height="46"
                                         Margin="12,0,12,12"
                                         materialDesign:HintAssist.Hint="PID"
                                         Text="{Binding ScannerSettings.Pid, UpdateSourceTrigger=PropertyChanged}"/>

                                <Button Grid.Row="1"
                                        Grid.Column="2"
                                        Content="Zapisz"
                                        Width="110"
                                        Height="38"
                                        Margin="12,4,0,12"
                                        VerticalAlignment="Top"
                                        Style="{StaticResource MaterialDesignRaisedButton}"
                                        Click="SaveScannerSettings_Click"/>

                                <TextBlock Grid.Row="2"
                                           Grid.ColumnSpan="4"
                                           Text="Po zmianie VID/PID aplikacja przełączy czytnik od razu."
                                           Style="{StaticResource AppMutedTextStyle}"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="{Binding SettingsStatus}"
                                   Style="{StaticResource AppMutedTextStyle}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>
    </Grid>
</Window>
