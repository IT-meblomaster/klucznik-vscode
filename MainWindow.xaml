<Window x:Class="MojaAplikacja.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="System"
        Height="760"
        Width="1240"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="5">
            <TextBlock Text="System RFID"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="5"/>

            <Button Content="Zablokuj"
                    DockPanel.Dock="Right"
                    Padding="10,4"
                    Margin="5"
                    Click="LockButton_Click"/>
        </DockPanel>

        <TabControl x:Name="MainTabs" Grid.Row="1">

            <TabItem Header="Skaner">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="1*"/>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Zeskanuj kartę pracownika i kartę klucza w ciągu 10 sekund"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Margin="0,0,0,18" />

                    <StackPanel Grid.Row="1"
                                Orientation="Horizontal"
                                Margin="0,0,0,18">
                        <TextBlock Text="Skan:"
                                   VerticalAlignment="Center"
                                   Width="60" />

                        <TextBox x:Name="CardInputTextBox"
                                 Width="320"
                                 Height="36"
                                 FontSize="18"
                                 Text="{Binding CardNumber, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="CardInputTextBox_KeyDown" />
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <GroupBox Header="Pracownik" Grid.Column="0">
                            <Grid Margin="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Imię"
                                           FontWeight="Bold"/>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding FirstName}"
                                           FontSize="24"
                                           Margin="0,4,0,14"/>

                                <TextBlock Grid.Row="2"
                                           Text="Nazwisko"
                                           FontWeight="Bold"/>
                                <TextBlock Grid.Row="3"
                                           Text="{Binding LastName}"
                                           FontSize="24"
                                           Margin="0,4,0,14"/>

                                <TextBlock Grid.Row="3"
                                           Text="{Binding EmployeeCardDisplay}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom"
                                           FontSize="14"/>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="Klucz" Grid.Column="2">
                            <Grid Margin="16">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Numer klucza"
                                           FontWeight="Bold"/>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding CurrentKeyName}"
                                           FontSize="24"
                                           Margin="0,4,0,14"/>

                                <TextBlock Grid.Row="2"
                                           Text="Opis"
                                           FontWeight="Bold"/>
                                <TextBlock Grid.Row="3"
                                           Text="{Binding CurrentKeyDescription}"
                                           FontSize="20"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,14"/>

                                <TextBlock Grid.Row="4"
                                           Text="{Binding CurrentKeyRfidStatus}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom"
                                           FontSize="14"/>
                            </Grid>
                        </GroupBox>
                    </Grid>

                    <GroupBox Grid.Row="3" Header="Log operacji">
                        <DataGrid ItemsSource="{Binding ScannerLogs}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Data i godzina"
                                                    Binding="{Binding Timestamp, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                    Width="200" />
                                <DataGridTextColumn Header="Opis"
                                                    Binding="{Binding Message}"
                                                    Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </GroupBox>

                    <TextBlock Grid.Row="4"
                               Text="{Binding Status}"
                               FontSize="16"
                               Margin="0,16,0,0"/>
                </Grid>
            </TabItem>

            <TabItem Header="Klucze">
                <Grid Margin="15">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0"
                                Orientation="Horizontal"
                                Margin="0,0,0,12">

                        <GroupBox Header="Klucze" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal" Margin="8,6,8,8">
                                <Button Content="Nowy"
                                        Width="100"
                                        Margin="0,0,8,0"
                                        Click="NewKey_Click"/>

                                <Button Content="Edytuj"
                                        Width="100"
                                        Margin="0,0,8,0"
                                        Click="EditKey_Click"
                                        IsEnabled="{Binding CanEditOrDeleteKey}"/>

                                <Button Content="Usuń"
                                        Width="100"
                                        Click="DeleteKey_Click"
                                        IsEnabled="{Binding CanEditOrDeleteKey}"/>
                            </StackPanel>
                        </GroupBox>

                        <GroupBox Header="RFID">
                            <StackPanel Orientation="Horizontal" Margin="8,6,8,8">
                                <Button Content="Przypisz RFID"
                                        Width="130"
                                        Margin="0,0,8,0"
                                        Click="AssignRfid_Click"
                                        IsEnabled="{Binding CanAssignRfid}"/>

                                <Button Content="Usuń RFID"
                                        Width="110"
                                        Click="RemoveRfid_Click"
                                        IsEnabled="{Binding CanRemoveRfid}"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>

                    <TextBlock Grid.Row="1"
                               Text="{Binding KeysStatus}"
                               Margin="0,0,0,12"
                               FontSize="14" />

                    <DataGrid Grid.Row="2"
                              ItemsSource="{Binding Keys}"
                              SelectedItem="{Binding SelectedKey, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              MouseDoubleClick="KeysGrid_MouseDoubleClick">
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsIssued}" Value="True">
                                        <Setter Property="Background" Value="#DCEEFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Nazwa"
                                                Binding="{Binding Name}"
                                                Width="250" />
                            <DataGridTextColumn Header="Opis"
                                                Binding="{Binding Description}"
                                                Width="*" />
                            <DataGridTextColumn Header="Status RFID"
                                                Binding="{Binding RfidStatus}"
                                                Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="Logi">
                <Grid>
                    <TextBlock Text="Moduł LOGI (placeholder)"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontSize="20"/>
                </Grid>
            </TabItem>

            <TabItem Header="Ustawienia">
                <Grid>
                    <TextBlock Text="Moduł USTAWIENIA (placeholder)"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center"
                               FontSize="20"/>
                </Grid>
            </TabItem>

        </TabControl>
    </Grid>
</Window>