<Window x:Class="Klucznik.KeyEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Klucz"
        Height="420"
        Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource AppPageBrush}"
        Style="{StaticResource MaterialDesignWindow}">

    <Border Margin="20"
            Padding="24"
            Background="{StaticResource AppSurfaceBrush}"
            BorderBrush="{StaticResource AppBorderBrush}"
            BorderThickness="1"
            CornerRadius="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBox x:Name="NameTextBox"
                     Grid.Row="0"
                     Height="46"
                     Margin="0,0,0,12"
                     materialDesign:HintAssist.Hint="Nazwa"/>

            <TextBox x:Name="BuildingTextBox"
                     Grid.Row="1"
                     Height="46"
                     Margin="0,0,0,12"
                     materialDesign:HintAssist.Hint="Budynek"/>

            <TextBox x:Name="HangerTextBox"
                     Grid.Row="2"
                     Height="46"
                     Margin="0,0,0,12"
                     materialDesign:HintAssist.Hint="Zawieszka"/>

            <TextBox x:Name="DescriptionTextBox"
                     Grid.Row="3"
                     MinHeight="110"
                     Margin="0,0,0,16"
                     materialDesign:HintAssist.Hint="Opis"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     VerticalContentAlignment="Top"/>

            <StackPanel Grid.Row="4"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right">
                <Button Content="Anuluj"
                        Width="110"
                        Height="38"
                        Margin="0,0,8,0"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Click="Cancel_Click"/>
                <Button Content="Zapisz"
                        Width="110"
                        Height="38"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Click="Save_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>

