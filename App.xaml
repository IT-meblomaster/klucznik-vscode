<Application x:Class="Klucznik.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:Klucznik"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             StartupUri="MainWindow.xaml">

    <Application.Resources>

        <ResourceDictionary>

            <ResourceDictionary.MergedDictionaries>

                <materialDesign:BundledTheme
                    BaseTheme="Light"
                    PrimaryColor="Blue"
                    SecondaryColor="LightBlue" />

                <ResourceDictionary
                    Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />

            </ResourceDictionary.MergedDictionaries>


            <!--
                Podstawowe kolory aplikacji
            -->

            <SolidColorBrush
                x:Key="AppPageBrush"
                Color="#F5F7FB"/>

            <SolidColorBrush
                x:Key="AppSurfaceBrush"
                Color="#FFFFFF"/>

            <SolidColorBrush
                x:Key="AppBorderBrush"
                Color="#DDE5F0"/>

            <SolidColorBrush
                x:Key="AppMutedBrush"
                Color="#64748B"/>

            <SolidColorBrush
                x:Key="AppTextBrush"
                Color="#172033"/>


            <!--
                Kolory komunikatu "wydano klucz".

                Wartości są domyślne.
                App.xaml.cs nadpisuje je wartościami z bazy.
            -->

            <SolidColorBrush
                x:Key="AppSuccessBrush"
                Color="#15803D"/>

            <SolidColorBrush
                x:Key="AppSuccessSurfaceBrush"
                Color="#DCFCE7"/>

            <SolidColorBrush
                x:Key="AppSuccessBorderBrush"
                Color="#86EFAC"/>


            <!--
                Kolory komunikatu "zwrócono klucz".
            -->

            <SolidColorBrush
                x:Key="AppReturnSurfaceBrush"
                Color="#F3E8FF"/>

            <SolidColorBrush
                x:Key="AppReturnBorderBrush"
                Color="#C084FC"/>


            <!--
                Pozostałe kolory aplikacji.
            -->

            <SolidColorBrush
                x:Key="AppDangerBrush"
                Color="#B91C1C"/>

            <SolidColorBrush
                x:Key="AppDangerSurfaceBrush"
                Color="#FEE2E2"/>


            <LinearGradientBrush
                x:Key="AppHeaderBrush"
                StartPoint="0,0"
                EndPoint="1,0">

                <GradientStop
                    Color="#1E3A8A"
                    Offset="0"/>

                <GradientStop
                    Color="#2563EB"
                    Offset="0.62"/>

                <GradientStop
                    Color="#0EA5E9"
                    Offset="1"/>

            </LinearGradientBrush>


            <Style
                x:Key="AppCardStyle"
                TargetType="Border">

                <Setter
                    Property="Background"
                    Value="{StaticResource AppSurfaceBrush}"/>

                <Setter
                    Property="BorderBrush"
                    Value="{StaticResource AppBorderBrush}"/>

                <Setter
                    Property="BorderThickness"
                    Value="1"/>

                <Setter
                    Property="CornerRadius"
                    Value="14"/>

                <Setter
                    Property="Padding"
                    Value="20"/>

                <Setter
                    Property="SnapsToDevicePixels"
                    Value="True"/>

            </Style>


            <Style
                x:Key="AppSectionTitleStyle"
                TargetType="TextBlock">

                <Setter
                    Property="FontSize"
                    Value="18"/>

                <Setter
                    Property="FontWeight"
                    Value="SemiBold"/>

                <Setter
                    Property="Foreground"
                    Value="{StaticResource AppTextBrush}"/>

                <Setter
                    Property="Margin"
                    Value="0,0,0,16"/>

            </Style>


            <Style
                x:Key="AppLabelStyle"
                TargetType="TextBlock">

                <Setter
                    Property="FontSize"
                    Value="12"/>

                <Setter
                    Property="FontWeight"
                    Value="SemiBold"/>

                <Setter
                    Property="Foreground"
                    Value="{StaticResource AppMutedBrush}"/>

                <Setter
                    Property="Margin"
                    Value="0,0,0,4"/>

            </Style>


            <Style
                x:Key="AppValueStyle"
                TargetType="TextBlock">

                <Setter
                    Property="FontSize"
                    Value="28"/>

                <Setter
                    Property="FontWeight"
                    Value="SemiBold"/>

                <Setter
                    Property="Foreground"
                    Value="{StaticResource AppTextBrush}"/>

                <Setter
                    Property="TextWrapping"
                    Value="Wrap"/>

            </Style>


            <Style
                x:Key="AppMutedTextStyle"
                TargetType="TextBlock">

                <Setter
                    Property="Foreground"
                    Value="{StaticResource AppMutedBrush}"/>

                <Setter
                    Property="TextWrapping"
                    Value="Wrap"/>

            </Style>

        </ResourceDictionary>

    </Application.Resources>

</Application>